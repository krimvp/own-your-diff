#!/usr/bin/env python3
"""Count questions and answers across quiz files, by category, kind, and relevance.

usage: quizstats [FILE|DIR ...]
  With no argument, read every quiz file in $(quizgate dir). A directory is
  searched for *quiz.json, so an eval run directory works too.
"""
import json
import subprocess
import sys
from collections import Counter, defaultdict
from pathlib import Path


def quiz_files(args):
    if not args:
        here = Path(__file__).resolve().parent
        args = [subprocess.run([str(here / "quizgate"), "dir"], capture_output=True, text=True, check=True).stdout.strip()]
    for arg in map(Path, args):
        if arg.is_dir():
            # An eval run keeps a second copy of each attempt's files under evidence/.
            yield from sorted(p for p in arg.rglob("*.json")
                              if p.name.endswith("quiz.json") and "evidence" not in p.relative_to(arg).parts)
        else:
            yield arg


def main(args):
    quizzes, unread = [], []
    for path in quiz_files(args):
        try:
            quiz = json.loads(path.read_text())
            quiz["questions"]
            quizzes.append(quiz)
        except (OSError, ValueError, KeyError, TypeError):
            unread.append(path)
    if not quizzes:
        sys.exit("quizstats: no quiz files found")

    rows = defaultdict(Counter)
    sizes = Counter()
    for quiz in quizzes:
        sizes[len(quiz["questions"])] += 1
        for q in quiz["questions"]:
            attempts = q.get("attempts") or []
            for key in (f"category {q.get('category')}", f"kind {q.get('kind')}", f"relevance {q.get('relevance')}"):
                row = rows[key]
                row["questions"] += 1
                if attempts:
                    row["answered"] += 1
                    row["first pass"] += attempts[0].get("verdict") == "pass"
                    row["passed"] += attempts[-1].get("verdict") == "pass"
                    row["retries"] += len(attempts) - 1

    total = sum(len(q["questions"]) for q in quizzes)
    print(f"{len(quizzes)} quizzes, {total} questions, "
          f"questions per quiz: " + ", ".join(f"{n}x{c}" for n, c in sorted(sizes.items())))
    outcomes = Counter(q.get("outcome", "plan") for q in quizzes)
    print("outcomes: " + ", ".join(f"{k} {v}" for k, v in sorted(outcomes.items())))
    print(f"\n{'':22}{'questions':>10}{'answered':>10}{'first pass':>12}{'passed':>8}{'retries':>9}")
    for key in sorted(rows):
        r = rows[key]
        rate = f"{r['first pass'] / r['answered']:.0%}" if r["answered"] else "-"
        print(f"{key:22}{r['questions']:>10}{r['answered']:>10}{rate:>12}{r['passed']:>8}{r['retries']:>9}")
    if unread:
        print(f"\nskipped {len(unread)} unreadable file(s): " + ", ".join(map(str, unread[:5])))


if __name__ == "__main__":
    main(sys.argv[1:])
