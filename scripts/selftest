#!/usr/bin/env bash
# Behavior tests for the plugin: the push gate through real `git push` into a
# bare remote, the snippet renderer, and the harness hooks.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
T="$(mktemp -d)"
trap 'rm -rf "$T"' EXIT
pass=0 fail=0

check() { # description expected-exit command...
  local want=$1 desc=$2; shift 2
  local got=0
  "$@" >"$T/out" 2>&1 || got=$?
  if [[ ( $want == ok && $got == 0 ) || ( $want == blocked && $got != 0 ) ]]; then
    pass=$((pass + 1)); echo "ok    $desc"
  else
    fail=$((fail + 1)); echo "FAIL  $desc (exit $got)"; sed 's/^/      /' "$T/out"
  fi
}

export HOME="$T/home" QUIZGATE_BIN="$T/home/.local/bin"
PATH="$QUIZGATE_BIN:$(tr : '\n' <<<"$PATH" | while read -r d; do [[ -x "$d/quizgate" ]] || printf '%s:' "$d"; done)"
export GIT_CONFIG_GLOBAL="$T/gitconfig" GIT_CONFIG_NOSYSTEM=1
git config --global user.email t@example.com
git config --global user.name t
git config --global init.defaultBranch main
gate="$ROOT/skills/own-your-diff/scripts/quizgate"
snip="$ROOT/skills/own-your-diff/scripts/snippet"

git init -q --bare "$T/remote.git"
git init -q "$T/work"
cd "$T/work"
git remote add origin "$T/remote.git"
commit() { echo "$2" >"$1"; git add -A; git commit -qm "$3"; }

commit a.txt one "root commit"
check ok "push with no hook installed" git push -q -u origin main
"$gate" install >/dev/null
check ok "install writes the opt-in marker" test -f .own-your-diff
check ok "install writes the pre-push hook" test -x "$(git rev-parse --git-path hooks)/pre-push"
git add .own-your-diff && git commit -qm "opt in"
check blocked "push is blocked while quizgate is not installed" git push -q
cp "$T/out" "$T/out.missing"
check ok "block message says how to install" grep -q "quizgate is not installed" "$T/out.missing"
"$gate" sync
check ok "sync puts quizgate in QUIZGATE_BIN" cmp -s "$gate" "$QUIZGATE_BIN/quizgate"
"$gate" record --by human >/dev/null
check ok "quizzed opt-in commit pushes" git push -q

commit a.txt two "change a"
check blocked "unquizzed commit is blocked" git push -q
cp "$T/out" "$T/out.blocked"
check ok "block message names the commit" grep -q "change a" "$T/out.blocked"

check ok "pending lists the commit" bash -c "$gate pending | grep -q 'change a'"
check ok "base is the last pushed commit" bash -c "[[ \$($gate base) == \$(git rev-parse origin/main) ]]"
"$gate" record --by human >/dev/null
check ok "quizzed commit pushes" git push -q
check ok "nothing pending after push" bash -c "[[ -z \$($gate pending) ]]"

git switch -qc feature
commit b.txt b1 "feature part 1"
commit b.txt b2 "feature part 2"
check ok "base with several pending commits is the branch point" bash -c "[[ \$($gate base) == \$(git rev-parse main) ]]"
"$gate" record --by human >/dev/null
git commit -q --amend -m "feature part 2, reworded"
check ok "reworded quizzed commit still pushes" git push -q --dry-run -u origin feature

git reset -q --soft main
git commit -qm "feature squashed"
check ok "squash of quizzed commits still pushes" git push -q --dry-run -u origin feature

commit b.txt b3 "sneaky edit"
check blocked "commit added after the quiz is blocked" git push -q --dry-run -u origin feature
check ok "pending holds only the new commit" bash -c "[[ \$($gate pending | wc -l) == 1 ]]"
"$gate" record --by human >/dev/null

git switch -q main
commit c.txt c1 "main moves on"
"$gate" record --by human >/dev/null
git push -q
git switch -q feature
git rebase -q main
check ok "rebased quizzed commits still push" git push -q -u origin feature

git commit -q --allow-empty -m "empty commit"
check ok "empty commit needs no quiz" git push -q

git branch -q doomed && git push -q origin doomed 2>/dev/null || true
check ok "deleting a remote branch is never blocked" git push -q origin --delete doomed

check blocked "record names who passed" "$gate" record
check ok "ledger keeps who passed" grep -q $'\thuman$' "$(git rev-parse --git-common-dir)/own-your-diff/ledger"

seq 1 20 >s.txt
git add s.txt && git commit -qm "twenty lines" && "$gate" record --by agent >/dev/null && git push -q
awk 'NR == 1 { $0 = "<b>&" } NR == 20 { $0 = "last" } 1' s.txt >s.new && mv s.new s.txt
git commit -qam "two hunks"
check ok "diff escapes html" bash -c "$snip diff s.txt | grep -q '&lt;b&gt;&amp;'"
check ok "diff shows only the hunks named" bash -c "[[ \$($snip diff s.txt 2 | grep -o 'class=\"l h\"' | wc -l) == 1 ]] && ! $snip diff s.txt 2 | grep -q 'lt;b'"
printf '<p>\n  <!-- snippet diff s.txt -->\n</p>\n' >page.html
"$snip" expand page.html && cp page.html page.first && "$snip" expand page.html
check ok "expand fills the directive" grep -q '<!-- snippet diff s.txt --><figure class="ed">' page.html
check ok "expand is idempotent" cmp -s page.html page.first

git clone -q "$T/remote.git" "$T/clone"
check ok "a fresh clone has no hook" bash -c "! test -e $T/clone/.git/hooks/pre-push"
(cd "$T/clone" && "$ROOT/hooks/session-start" >"$T/ctx")
check ok "session start installs the hook in an opted-in clone" test -x "$T/clone/.git/hooks/pre-push"
check ok "session start tells the agent the repo is opted in" grep -q "own-your-diff skill" "$T/ctx"
(cd "$T/clone" && commit z.txt z "clone change")
check blocked "the clone blocks an unquizzed push" git -C "$T/clone" push -q

git clone -q "$T/remote.git" "$T/stale"
git -C "$T/stale" config core.hooksPath .githooks
(cd "$T/stale" && "$ROOT/hooks/session-start" >"$T/ctx.stale")
check ok "session start unsets a core.hooksPath that points nowhere" bash -c "! git -C $T/stale config core.hooksPath"
check ok "and installs the hook in that clone" test -x "$T/stale/.git/hooks/pre-push"
check ok "and tells the agent what it changed" grep -q "unset core.hooksPath=.githooks" "$T/ctx.stale"
mkdir -p "$T/stale/.husky"
git -C "$T/stale" config core.hooksPath .husky
(cd "$T/stale" && "$ROOT/hooks/session-start" >/dev/null 2>&1)
check ok "session start keeps a core.hooksPath that exists" bash -c "[[ \$(git -C $T/stale config core.hooksPath) == .husky ]]"
check ok "and writes nothing into the directory it names" bash -c "[[ -z \$(ls -A $T/stale/.husky) ]]"
check blocked "install refuses while core.hooksPath manages the hooks" bash -c "cd $T/stale && $gate install"

git init -q "$T/foreign"
printf '#!/bin/sh\nexit 0\n' >"$T/foreign/.git/hooks/pre-push"
check blocked "install leaves a foreign pre-push hook alone" bash -c "cd $T/foreign && $gate install"
check ok "the foreign hook is unchanged" bash -c "! grep -q own-your-diff $T/foreign/.git/hooks/pre-push"
git init -q "$T/plain"
check ok "session start says nothing outside opted-in repos" bash -c "cd $T/plain && [[ -z \$($ROOT/hooks/session-start) ]]"

guard() { printf '{"tool_name":"%s","tool_input":{"command":"%s"}}' "$1" "$2" | "$ROOT/hooks/guard"; }
denies() { guard "$1" "$2" | grep -q '"permissionDecision":"deny"'; }
check ok "guard denies git push --no-verify from Bash" denies Bash "git push --no-verify origin main"
check ok "guard denies git push --no-verify from Execute" denies Execute "cd x && git push -u origin f --no-verify"
check ok "guard denies a core.hooksPath override" denies Bash "git -c core.hooksPath=/dev/null push"
check ok "guard allows a plain push" bash -c "[[ -z \$(guard Bash 'git push -u origin main') ]]"
check ok "guard allows commit --no-verify" bash -c "[[ -z \$(guard Bash 'git commit --no-verify -m x') ]]"
check ok "guard allows reading core.hooksPath" bash -c "[[ -z \$(guard Bash 'git config --get core.hooksPath') ]]"

lint="$ROOT/skills/own-your-diff/scripts/quizlint"
mkdir -p "$T/quiz"
python3 - "$T/quiz" "$ROOT/skills/own-your-diff/references/quiz-file.md" <<'PY'
import copy, json, re, sys
out, doc = sys.argv[1], open(sys.argv[2]).read()
open(f"{out}/doc-example.json", "w").write(re.search(r"```json\n(.*?)```", doc, re.S).group(1))
opt = lambda label, ok: {"label": label, "correct": ok}
single = {"id": "q1", "kind": "single", "category": "rationale", "relevance": "core", "prompt": "p",
          "options": [opt("a", True), opt("b", False)], "key_points": ["k"]}
multi = {"id": "q2", "kind": "multi", "category": "failure", "relevance": "useful", "prompt": "p",
         "options": [opt("a", True), opt("b", True), opt("c", False)], "key_points": ["k"]}
free = {"id": "q3", "kind": "free", "category": "extension", "relevance": "important", "prompt": "p", "key_points": ["k"]}
def quiz(questions, examinee="human", **top):
    return {"version": 1, "branch": "b", "base": "a1", "head": "b2", "target": "t",
            "altitude": "design", "incidental": [], "examinee": examinee,
            "questions": copy.deepcopy(questions), **top}
def answered(q, *verdicts):
    q = copy.deepcopy(q)
    q["attempts"] = [{"answer": "x", "verdict": v} for v in verdicts]
    return q
two_right = copy.deepcopy(single); two_right["options"][1]["correct"] = True
trivia = dict(free, category="trivia")
cases = {
    "plan-ok": quiz([single, free, multi]),
    "plan-empty": quiz([]),
    "plan-eleven": quiz([dict(free, id=f"f{i}") for i in range(11)]),
    "plan-two-right": quiz([two_right]),
    "plan-opens-free": quiz([free, single]),
    "plan-ends-single": quiz([single, dict(single, id="q4")]),
    "plan-trivia": quiz([trivia]),
    "plan-useful-first": quiz([dict(single, relevance="useful"), dict(free, relevance="core"), multi]),
    "plan-core-closes": quiz([single, dict(free, relevance="useful"), dict(multi, relevance="core")]),
    "plan-no-relevance": quiz([{k: v for k, v in free.items() if k != "relevance"}]),
    "plan-agent-single": quiz([single], examinee="agent"),
    "plan-with-attempts": quiz([answered(free, "pass")]),
    "done-ends-vague": quiz([answered(free, "wrong", "vague")], outcome="passed"),
    "done-ends-pass": quiz([answered(free, "vague", "pass")], outcome="passed"),
}
for name, body in cases.items():
    json.dump(body, open(f"{out}/{name}.json", "w"))
PY
refuses() { # file message [--plan]
  ! "$lint" ${3:-} "$T/quiz/$1.json" >"$T/lint.out" && grep -qF "$2" "$T/lint.out"
}
check ok "quizlint passes a plan that opens single and ends multi" "$lint" --plan "$T/quiz/plan-ok.json"
check ok "quizlint passes a plan with no questions" "$lint" --plan "$T/quiz/plan-empty.json"
check ok "quizlint passes the example in quiz-file.md" "$lint" "$T/quiz/doc-example.json"
check ok "quizlint passes a passed quiz that ends on a pass" "$lint" "$T/quiz/done-ends-pass.json"
check ok "quizlint refuses 11 questions" refuses plan-eleven "more than 10" --plan
check ok "quizlint refuses a single with two correct options" refuses plan-two-right "exactly one correct" --plan
check ok "quizlint refuses a quiz that opens with free" refuses plan-opens-free "opens with a single" --plan
check ok "quizlint refuses a quiz that ends with single" refuses plan-ends-single "ends with a multi or a free" --plan
check ok "quizlint refuses an unknown category" refuses plan-trivia "category is one of" --plan
check ok "quizlint refuses a useful question before a core one" refuses plan-useful-first "most to least relevant" --plan
check ok "quizlint lets the closing question be more relevant than the one before" "$lint" --plan "$T/quiz/plan-core-closes.json"
check ok "quizlint refuses a question without a relevance" refuses plan-no-relevance "relevance is one of" --plan
check ok "quizlint refuses select questions for an agent examinee" refuses plan-agent-single "free questions only" --plan
check ok "quizlint refuses attempts in a plan" refuses plan-with-attempts "no attempts yet" --plan
check ok "quizlint refuses a passed quiz whose last attempt is not a pass" refuses done-ends-vague "ends every question on a pass"
mkdir -p "$T/stats/evidence" && cp "$T/quiz/done-ends-pass.json" "$T/stats/a.quiz.json" && cp "$T/quiz/done-ends-pass.json" "$T/stats/evidence/a.quiz.json"
"$ROOT/skills/own-your-diff/scripts/quizstats" "$T/stats" >"$T/stats.out"
check ok "quizstats counts each quiz once, skipping evidence copies" grep -q "^1 quizzes, 1 questions" "$T/stats.out"
check ok "quizstats reports the first-try pass rate by category" grep -q "category extension *1 *1 *0%" "$T/stats.out"

plain="$ROOT/skills/own-your-diff/scripts/plainlint"
long="This sentence keeps going with one more clause and then another clause and then yet another clause so that it ends up far past the limit."
printf '<main><p>Short and clear. The grader reads the file.</p><figure class="ed"><pre>%s</pre></figure></main>\n' "$long" >"$T/plain-ok.html"
printf '<main><p>%s</p></main>\n' "$long" >"$T/plain-long.html"
check ok "plainlint passes plain prose and leaves code blocks out" bash -c "'$plain' '$T/plain-ok.html' | grep -q '0 note(s)'"
check ok "plainlint notes a long sentence without failing" bash -c "'$plain' '$T/plain-long.html' | grep -q '^note: 26 words'"
check blocked "plainlint fails the template, which still holds its placeholders" "$plain" "$ROOT/skills/own-your-diff/assets/explainer.html"

version() { grep -o '"version": *"[^"]*"' "$ROOT/$1"; }
check ok "Claude and Codex manifests carry the same version" bash -c "[[ '$(version .claude-plugin/plugin.json)' == '$(version .codex-plugin/plugin.json)' ]]"

echo "$pass passed, $fail failed"
[[ $fail == 0 ]]
