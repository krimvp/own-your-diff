+        because: { violations: [{ delivered: 2, first: true }] },
+      },
+      'host-enable text is never delivered': {
+        broken: async () => {
+          const log = await hostEnabled()
+          return editUser(log, (ms) => ms.findIndex((m, i) => i > pendingIn(ms) && asMessage(m).role === 'user'), (content) => content.replace(pendingText(log), ''))
+        },
+        because: { violations: [{ delivered: 0, first: false }] },
+      },
+    },
+  },
+} satisfies Record<Invariant, InvariantCase>
+
+for (const [name, c] of Object.entries(invariantCases) as [Invariant, InvariantCase][]) {
+  for (const [bug, { broken, because }] of Object.entries(c.bugs)) {
+    test(`${name} holds on a correct run and fails when ${bug}`, async () => {
+      const held = check(await c.holds()).invariants[name]
+      const verdict = check(await broken()).invariants[name]
+
+      assert.equal(held.kind, 'pass', 'the correct run passes')
+      assert.deepEqual(pick(held.evidence, c.exercised), c.exercised, 'the correct run exercised the invariant')
+      assert.equal(verdict.kind, 'fail', 'the broken run fails')
+      assert.deepEqual(pick(verdict.evidence, because), because, 'it fails for the bug the fault stands for')
+    })
+  }
+}

From 68ee9901070e78b542445de8f6b8958577ec98d9 Mon Sep 17 00:00:00 2001
From: krimvp <anton.balboa@gmail.com>
Date: Sun, 18 Oct 2026 14:07:46 +0200
Subject: [PATCH 3/3] feat: add aigent run and aigent check over the result
 directory

multeval will drive aigent as a command on a host work directory and
grade the files it leaves, so the runner and the checks need a headless
shell. aigent run runs one scenario on an OpenAI-compatible model, writes
the result directory, then grades the files it just wrote rather than its
memory, so every run proves the directory is enough to grade it. aigent
check grades an existing directory. Both print the report as JSON.

The exit code says what kind of trouble a run had: 1 for a failed
invariant, which is an engine bug and wins over 3; 2 for bad input found
before anything ran; 3 for a run that stopped early, which is still
written and checked; 4 for a runner failure. Behaviors never change it.
aigent run refuses an existing directory before it reads the scenario,
so a repeated command never spends a model call.

package.json gains the bin and an npm script that loads .env, so a
human runs it as npm run aigent -- run <scenario> --out <dir> --model <id>.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
