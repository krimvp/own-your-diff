+#!/usr/bin/env node
+// `aigent run` and `aigent check`. The whole shell: argv and the environment in, a result directory and one JSON
+// report on stdout out. Progress and problems go to stderr.
+
+import { stat } from 'node:fs/promises'
+import { dirname } from 'node:path'
+import { parseArgs } from 'node:util'
+import { check, type Report } from './eval/checks.ts'
+import { readRun, RunFileError, runScenario, writeRun, type StepLog } from './eval/run.ts'
+import { readScenario, ScenarioError } from './eval/scenario.ts'
+import { createSession, type ModelSpec, type ToolMode } from './index.ts'
+
+const USAGE = `usage:
+  aigent run <scenario.json> --out <dir> --model <id> [--tool-mode native|dispatch]
+             [--base-url <url>] [--api-key-env <NAME>] [--prompt-timeout <seconds>]
+  aigent check <dir>
+
+run    runs the scenario on an OpenAI-compatible model, writes the result directory <dir>
+       (which must not exist), then checks the files it wrote.
+       defaults: --tool-mode native, --base-url https://ollama.com/v1, --api-key-env OLLAMA_API_KEY,
+       --prompt-timeout 240
+check  checks an existing result directory.
+
+stdout: the report as JSON. exit: 0 complete and every invariant held, 1 an invariant failed,
+2 bad usage or input and nothing ran, 3 the run stopped before its last step, 4 the runner failed.`
+
+/**
+ * 0  every step ran and every invariant held. Behaviors never change the code; they are rates, not gates.
+ * 1  an invariant failed: an engine bug. Wins over 3.
+ * 2  bad argv, scenario, result directory or environment, found before anything ran. Nothing written.
+ * 3  the run stopped early: a prompt ended `error` or `aborted` (provider failure, timeout, Ctrl-C) or a step threw.
+ *    The steps that ran were written and checked.
+ * 4  the runner itself failed. Nothing written.
+ */
+type Exit = 0 | 1 | 2 | 3 | 4
+
+type Command =
+  | {
+      readonly kind: 'run'
+      readonly scenario: string
+      readonly out: string
+      readonly model: Extract<ModelSpec, { readonly kind: 'openai-compatible' }>
+      readonly toolMode: ToolMode
+      readonly promptTimeoutMs: number
+    }
+  | { readonly kind: 'check'; readonly dir: string }
+
+/** The argv boundary. A string is the problem that makes it exit 2. */
+function parseCommand(argv: readonly string[]): Command | string {
+  let parsed
+  try {
+    parsed = parseArgs({
+      args: [...argv],
+      allowPositionals: true,
+      strict: true,
+      options: {
+        out: { type: 'string' },
+        model: { type: 'string' },
+        'tool-mode': { type: 'string' },
+        'base-url': { type: 'string' },
+        'api-key-env': { type: 'string' },
+        'prompt-timeout': { type: 'string' },
+      },
+    })
+  } catch (error) {
+    return messageOf(error)
+  }
+  const { values, positionals } = parsed
+  const [command, path, ...extra] = positionals
+  if (!path || extra.length > 0) return 'expected a command and one path'
+  if (command === 'check') return Object.keys(values).length > 0 ? 'check takes no flags' : { kind: 'check', dir: path }
+  if (command !== 'run') return `unknown command "${command}"`
+  if (!values.out || !values.model) return 'run needs --out and --model'
+  const toolMode = values['tool-mode'] ?? 'native'
+  if (toolMode !== 'native' && toolMode !== 'dispatch') return '--tool-mode must be native or dispatch'
+  const seconds = Number(values['prompt-timeout'] ?? '240')
+  if (!(seconds > 0)) return '--prompt-timeout must be a positive number of seconds'
+  const apiKeyEnv = values['api-key-env'] ?? 'OLLAMA_API_KEY'
+  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(apiKeyEnv)) return '--api-key-env must name an environment variable'
+  const model = { kind: 'openai-compatible', baseUrl: values['base-url'] ?? 'https://ollama.com/v1', id: values.model, apiKeyEnv } as const
+  return { kind: 'run', scenario: path, out: values.out, model, toolMode, promptTimeoutMs: seconds * 1000 }
+}
+
+async function main(argv: readonly string[]): Promise<Exit> {
+  const command = parseCommand(argv)
+  if (typeof command === 'string') return refuse(`${command}\n\n${USAGE}`)
+  if (command.kind === 'check') {
+    const run = await readRun(command.dir).catch(refusal(RunFileError))
+    return typeof run === 'number' ? run : print(check(run))
+  }
+
+  if (await exists(command.out)) return refuse(`${command.out} already exists`)
+  const scenario = await readScenario(command.scenario).catch(refusal(ScenarioError))
+  if (typeof scenario === 'number') return scenario
+  const controller = new AbortController()
+  process.once('SIGINT', () => controller.abort())
+  const log = await runScenario(scenario, {
+    root: dirname(command.scenario),
+    open: createSession,
+    model: command.model,
+    toolMode: command.toolMode,
+    promptTimeoutMs: command.promptTimeoutMs,
+    signal: controller.signal,
+    onStep: (step, ran) => process.stderr.write(`aigent: step ${step}/${scenario.steps.length} ${progress(ran)}\n`),
+  }).catch(refusal(ScenarioError))
+  if (typeof log === 'number') return log
+  await writeRun(command.out, log)
+  // The verdict comes from the files, so every run proves they are enough to grade it.
+  return print(check(await readRun(command.out)))
+}
+
+function progress(step: StepLog): string {
+  switch (step.kind) {
+    case 'prompt':
+      return `prompt: ${step.result.stop} after ${step.result.turns} turns`
+    case 'enable':
+    case 'resume':
+      return step.kind
+    default:
+      return step satisfies never
+  }
+}
+
+function print(report: Report): Exit {
+  process.stdout.write(`${JSON.stringify(report, null, 2)}\n`)
+  if (Object.values(report.invariants).some((verdict) => verdict.kind === 'fail')) return 1
+  return report.complete ? 0 : 3
+}
+
+function refuse(problem: string): Exit {
+  process.stderr.write(`aigent: ${problem}\n`)
+  return 2
+}
+
+/** Turns a rejection of the boundary's own error class into exit 2, and lets anything else reach exit 4. */
+function refusal(kind: new (...args: never[]) => Error): (error: unknown) => Exit {
+  return (error) => {
+    if (error instanceof kind) return refuse(error.message)
+    throw error
+  }
+}
+
+async function exists(path: string): Promise<boolean> {
+  return stat(path).then(
+    () => true,
+    (error: NodeJS.ErrnoException) => {
+      if (error.code === 'ENOENT') return false
+      throw error
+    },
+  )
+}
+
+function messageOf(error: unknown): string {
+  return error instanceof Error ? error.message : String(error)
+}
+
+process.exitCode = await main(process.argv.slice(2)).catch((error: unknown) => {
+  process.stderr.write(`aigent: ${error instanceof Error ? (error.stack ?? error.message) : String(error)}\n`)
+  return 4
+})
diff --git a/test/cli.test.ts b/test/cli.test.ts
new file mode 100644
index 0000000..ed18259
--- /dev/null
+++ b/test/cli.test.ts
@@ -0,0 +1,66 @@
+// The CLI over the result directory, the contract the multeval grader will read: `aigent check` grades the files
+// exactly as `check` grades the run in memory and exits by what the run went through, and `aigent run` refuses a
+// directory that exists before it spends a model call.
+
+import assert from 'node:assert/strict'
+import { spawnSync } from 'node:child_process'
+import { mkdir, mkdtemp, readdir } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { test } from 'node:test'
+import { check } from '../src/eval/checks.ts'
+import { runScenario, writeRun, type RunLog } from '../src/eval/run.ts'
+import { parseScenario, readScenario, type Scenario } from '../src/eval/scenario.ts'
+import { call, FAUX, fauxModel, reply, type Reply } from './fixtures/faux.ts'
+
+// Before any run loads the weather plugin, which echoes it.
+process.env.WEATHER_API_KEY = 'sk-canary-0123456789'
+const CLI = join(import.meta.dirname, '..', 'src', 'cli.ts')
+const root = join(import.meta.dirname, 'scenarios')
+
+const aigent = (args: readonly string[], env: NodeJS.ProcessEnv = {}) => spawnSync(process.execPath, [CLI, ...args], { encoding: 'utf8', env: { ...process.env, ...env } })
+
+async function run(scenario: Scenario, script: readonly Reply[]): Promise<RunLog> {
+  const model = fauxModel(script)
+  const log = await runScenario(scenario, { root, open: model.open, model: FAUX, toolMode: 'native', promptTimeoutMs: 5_000 })
+  assert.equal(model.pending(), 0, 'the run used its whole script')
+  return log
+}
+
+/** The run as if the engine had leaked a secret into its transcript: the scrub's mark is what secret-free reads. */
+const leaked = (log: RunLog): RunLog => ({ ...log, transcript: { ...log.transcript, messages: [...log.transcript.messages, { role: 'user', content: '[LEAKED:WEATHER_API_KEY]', timestamp: 0 }] } })
+
+const lisbon = [call('core__enable_plugin', { name: 'weather' }), call('weather__get_weather', { city: 'Lisbon' }), reply('It is 17°C in Lisbon right now.')]
+
+test('aigent check prints the report check makes in memory, and exits by what the run went through', async () => {
+  const held = await run(await readScenario(join(root, 'weather.json')), [...lisbon, call('weather__get_weather', { city: 'Porto' }), reply('Porto is at 17°C too.')])
+  // The clock set lacks weather, which the saved records enabled, so the resume throws.
+  const stopped = await run(
+    parseScenario({ format: 'aigent-scenario/1', plugins: ['plugins/weather'], secrets: ['WEATHER_API_KEY'], systemPrompt: 'Test.', steps: [{ kind: 'prompt', text: 'Weather in Lisbon?' }, { kind: 'resume', plugins: ['plugins/clock'] }] }),
+    lisbon,
+  )
+  const parent = await mkdtemp(join(tmpdir(), 'aigent-cli-'))
+  const exits = { held: [held, 0], leaked: [leaked(held), 1], stopped: [stopped, 3], 'leaked and stopped': [leaked(stopped), 1] } as const
+
+  for (const [name, [log, code]] of Object.entries(exits)) {
+    await writeRun(join(parent, name), log)
+    const child = aigent(['check', join(parent, name)])
+    assert.equal(child.status, code, `${name}: ${child.stderr}`)
+    assert.deepEqual(JSON.parse(child.stdout), check(log), `${name}: the files grade as the run`)
+  }
+  await mkdir(join(parent, 'empty'))
+  const refused = aigent(['check', join(parent, 'empty')])
+  assert.equal(refused.status, 2, 'a directory that holds no run is bad input')
+  assert.equal(refused.stdout, '')
+})
+
+test('aigent run refuses an existing result directory before it calls a model', async () => {
+  const dir = await mkdtemp(join(tmpdir(), 'aigent-cli-'))
+  // Everything else is in order, so only the directory can stop it; past that check the dead endpoint would fail later, as exit 4.
+  const child = aigent(['run', join(root, 'weather.json'), '--out', dir, '--model', 'm', '--base-url', 'http://127.0.0.1:9'], { OLLAMA_API_KEY: 'unused' })
+
+  assert.equal(child.status, 2, child.stderr)
+  assert.ok(child.stderr.includes(dir), 'the refusal names the directory')
+  assert.equal(child.stdout, '')
+  assert.deepEqual(await readdir(dir), [])
+})
