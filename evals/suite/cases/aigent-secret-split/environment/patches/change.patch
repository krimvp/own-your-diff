@@ -93,10 +94,11 @@ export async function startSession(options: SessionOptions, resolved: ResolvedMo
       return (await engine.endTurn(toTurn(turn.message))) === 'stop' ? { action: 'end' } : undefined
     },
   })
+  const text = holdBack(Math.max(0, ...Object.values(secrets).map((v) => v.length)), engine.redact, (delta) => dispatch({ type: 'text', delta }))
   agent.subscribe((event) => {
-    if (event.type === 'message_update' && event.assistantMessageEvent.type === 'text_delta') {
-      dispatch({ type: 'text', delta: event.assistantMessageEvent.delta })
-    }
+    if (event.type === 'message_update' && event.assistantMessageEvent.type === 'text_delta') text.push(event.assistantMessageEvent.delta)
+    // pi ends every assistant message this way, whether it finished, errored or was aborted.
+    else if (event.type === 'message_end') text.flush()
   })
 
   const flush = (): void => {
@@ -266,6 +268,29 @@ function exportMessage(message: AgentMessage, redact: (text: string) => string):
   }
 }
 
+/**
+ * Redacting each delta alone lets a listener rejoin a secret split across deltas. Any secret that could still be
+ * completing starts within the last `longest - 1` characters, so those wait for more text or the message's end.
+ */
+function holdBack(longest: number, redact: (text: string) => string, emit: (delta: string) => void) {
+  let held = ''
+  return {
+    push(delta: string): void {
+      held = redact(held + delta)
+      let cut = held.length - Math.max(0, longest - 1)
+      // Never strand half of a surrogate pair at the end of a delta.
+      if (cut > 0 && /[\uD800-\uDBFF]/.test(held[cut - 1]!)) cut -= 1
+      if (cut <= 0) return
+      emit(held.slice(0, cut))
+      held = held.slice(cut)
+    },
+    flush(): void {
+      if (held) emit(held)
+      held = ''
+    },
+  }
+}
+
 /** Deep-redacts strings in our own JSON-shaped values. Image data is left alone. */
 function redactJson<T>(value: T, redact: (text: string) => string): T {
   if (typeof value === 'string') return redact(value) as T
