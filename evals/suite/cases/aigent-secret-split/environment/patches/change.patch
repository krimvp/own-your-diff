+test('streamed deltas never rejoin a split secret or split a character, and the text arrives whole', async () => {
+  // Longer than the faux provider's largest chunk (20 characters), so every run splits it across deltas.
+  const key = 'sk-station-0123456789abcdef'
+  // The last cut falls 26 characters before the end, between the two halves of an emoji.
+  const rain = `${'🌧'.repeat(20)}!`
+  const { session } = await fauxSession({ model: { kind: 'builtin', provider: 'faux', id: 'faux-1' }, systemPrompt: 'Test.', plugins: [], secrets: { STATION_KEY: key } }, [
+    reply(`The station key is ${key}, keep it safe. ${rain}`),
+  ])
+  const deltas: string[] = []
+  session.subscribe((e) => {
+    if (e.type === 'text') deltas.push(e.delta)
+  })
+
+  await session.prompt('Hi')
+
+  assert.equal(deltas.join(''), `The station key is [REDACTED:STATION_KEY], keep it safe. ${rain}`)
+  assert.deepEqual(deltas.filter((d) => /^[\uDC00-\uDFFF]|[\uD800-\uDBFF]$/.test(d)), [], 'no delta ends or starts inside a surrogate pair')
+})
+
+test('an abort mid-reply still delivers every character the transcript kept', async () => {
+  const key = 'sk-station-0123456789abcdef'
+  const text = `The station key is ${key}, keep it safe.`
+  const controller = new AbortController()
+  // Paced by timers, so the abort lands before the provider streams the rest of the reply.
+  const { session } = await fauxSession({ model: { kind: 'builtin', provider: 'faux', id: 'faux-1' }, systemPrompt: 'Test.', plugins: [], secrets: { STATION_KEY: key } }, [reply(text)], { tokensPerSecond: 1_000_000 })
+  const deltas: string[] = []
+  session.subscribe((e) => {
+    if (e.type !== 'text') return
+    deltas.push(e.delta)
+    controller.abort()
+  })
+
+  assert.equal((await session.prompt('Hi', { signal: controller.signal })).stop, 'aborted')
+
+  const kept = session.transcript().messages.flatMap((m) => {
+    const message = m as { role?: string; content?: { type: string; text?: string }[] }
+    return message.role === 'assistant' ? (message.content ?? []).flatMap((c) => (c.type === 'text' ? [c.text ?? ''] : [])) : []
+  })
+  assert.ok(kept.join('').length < text.length, 'the abort cut the reply short')
+  assert.equal(deltas.join(''), kept.join(''), 'the held-back tail reached listeners')
+})
+
